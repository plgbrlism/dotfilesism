# labwc window manager colors
# generated by rizzoo

# ~~ borders ~~
border.width: 2
window.active.border.color: {{ primary }}
window.inactive.border.color: {{ surface_container }}

# ~~ titlebar ~~
window.active.title.bg.color: {{ primary }}
window.inactive.title.bg.color: {{ surface_container }}
window.active.label.text.color: {{ on_primary }}
window.inactive.label.text.color: #{{ on_surface }}

# ~~ buttons hover ~~
window.button.hover.bg.color: {{ tertiary }}

# ~~ menu ~~
menu.items.bg.color: {{ surface }}
menu.items.text.color: {{ on_surface }}
menu.items.active.bg.color: {{ primary }}
menu.items.active.text.color: {{ on_primary }}
