// ~~ layout ~~

layout {
    gaps 12
    background-color "transparent"

    border     { off; }
    focus-ring { off; }
    shadow     { off; }

	insert-hint {
        color "rgba(209, 147, 145, 0.8)"
    }

    tab-indicator {
    	active-color "hsl(2, 41%, 69%)"
    	inactive-color "hsl(4, 9%, 29%)"
    	urgent-color "#ff7b6e"
    }
}

overview {
	backdrop-color "rgba(209, 147, 145, 1.0)"
	workspace-shadow { off; }
}

window-rule {
    match is-floating=true
    border {
        on
        width 2
        active-color "rgba(209, 147, 145, 1.0)"
        inactive-color "rgba(81, 68, 67, 1.0)"
    }
    focus-ring {
        on
        width 2
        active-color "rgba(209, 147, 145, 1.0)"
        inactive-color "rgba(81, 68, 67, 1.0)"    	
    }
}

recent-windows {
    highlight {
        active-color "hsl(3, 83%, 84%)"
        urgent-color "hsl(5, 100%, 72%)"        
        padding 20
        corner-radius 8
    }
}
